# Database Configurations
# Direct URL for migrations (bypasses PgBouncer):
DIRECT_URL="postgresql://user:password@host.c-6.us-east-1.aws.neon.tech/dbname?sslmode=require"
# Pooled URL for application queries (uses Neon PgBouncer):
DATABASE_URL="postgresql://user:password@host-pooler.c-6.us-east-1.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=10"

# Local Database Configuration (uncomment to test locally with Docker PgBouncer)
# DIRECT_URL="postgresql://postgres:password@localhost:5432/outsourcing_db"
# DATABASE_URL="postgresql://postgres:password@localhost:6432/outsourcing_db?pgbouncer=true&connection_limit=20"

PORT=3000
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
JWT_SECRET=""

# Redis Configuration (Local Docker container or Production Redis)
REDIS_URL="redis://localhost:6379"
